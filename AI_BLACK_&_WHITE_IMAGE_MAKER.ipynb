      "source": [
        "import cv2\n",
        "import gradio as gr\n",
        "\n",
        "def bw_image(image):\n",
        "    gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)\n",
        "    return gray\n",
        "\n",
        "gr.Interface(\n",
        "    fn=bw_image,\n",
        "    inputs=gr.Image(type=\"numpy\"),\n",
        "    outputs=gr.Image(),\n",
        "    title=\"AI Black & White Converter\"\n",
        ").launch()\n"
      ],
